diff --git a/mobile/ios/app/musehideback/content.js b/mobile/ios/app/musehideback/content.js
new file mode 100644
index 000000000000..000000000000
--- /dev/null
+++ b/mobile/ios/app/musehideback/content.js
@@ -0,0 +1,45 @@
+// Muse: hide the back button in the muse.ai chat header.
+// That button is drawn by the muse.ai web app itself (not by the browser),
+// so hide it from inside the page. Re-applies as the React app re-renders.
+(function () {
+  "use strict";
+  var LABEL_RE = /back|quay|tr\u1edf/i;
+  function isBackControl(el) {
+    if (!el || el.nodeType !== 1) return false;
+    var label = (el.getAttribute("aria-label") || "") + " " + (el.getAttribute("title") || "");
+    return LABEL_RE.test(label);
+  }
+  function hideIn(root) {
+    if (!root) return;
+    if (root.nodeType === 1 && isBackControl(root)) {
+      root.style.display = "none";
+    }
+    if (root.querySelectorAll) {
+      var nodes = root.querySelectorAll("button, a, [role='button']");
+      for (var i = 0; i < nodes.length; i++) {
+        if (isBackControl(nodes[i])) {
+          nodes[i].style.display = "none";
+        }
+      }
+    }
+  }
+  hideIn(document);
+  var observer = new MutationObserver(function (mutations) {
+    for (var i = 0; i < mutations.length; i++) {
+      var m = mutations[i];
+      if (m.type === "childList") {
+        for (var j = 0; j < m.addedNodes.length; j++) {
+          hideIn(m.addedNodes[j]);
+        }
+      } else if (m.type === "attributes" && isBackControl(m.target)) {
+        m.target.style.display = "none";
+      }
+    }
+  });
+  observer.observe(document.documentElement, {
+    childList: true,
+    subtree: true,
+    attributes: true,
+    attributeFilter: ["aria-label", "title"]
+  });
+})();
